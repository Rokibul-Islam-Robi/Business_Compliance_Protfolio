# Uploaded files are images ONLY: never execute anything from this folder.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|html?|js)$">
  Require all denied
</FilesMatch>
